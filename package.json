{
  "private": true,
  "name": "carepackagegame",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run test:types && npm run lint && npm run test:unit && npm run build",
    "deploy": "node scripts/release-guard.mjs blocked-legacy",
    "deploy:prod": "node scripts/release-guard.mjs prod && npm run check && devvit upload && devvit install CarePackageGame",
    "deploy:test": "node scripts/release-guard.mjs test && npm run check && devvit upload && devvit install thumbprint_daily_dev",
    "dev": "node scripts/release-guard.mjs playtest && devvit playtest",
    "hooks:install": "node scripts/install-hooks.mjs",
    "launch": "node scripts/release-guard.mjs blocked-legacy",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "logs:prod": "devvit logs CarePackageGame",
    "logs:test": "devvit logs thumbprint_daily_dev",
    "prettier": "prettier --write .",
    "publish:prod": "node scripts/release-guard.mjs prod && npm run check && devvit upload && devvit publish",
    "rollback:prod": "node scripts/release-guard.mjs rollback",
    "test:types": "tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.4",
    "@devvit/web": "0.15.4",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.4",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.4.0"
  }
}