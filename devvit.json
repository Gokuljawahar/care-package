{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "thumbprint-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create today's Care Package post",
        "description": "Closes the current day and posts the next one",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-today"
      },
      {
        "label": "Debug: set my Health to 1 (+5 Scrap)",
        "description": "DEV ONLY (thumbprint_daily_dev): sets your bunker Health to 1 and adds +5 Scrap",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/debug-hurt"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "permissions": {
    "redis": true,
    "reddit": true
  },
  "scheduler": {
    "tasks": {
      "daily-reset": {
        "endpoint": "/internal/scheduler/daily-reset",
        "cron": "0 0 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "thumbprint_daily_dev"
  }
}