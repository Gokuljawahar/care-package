#!/usr/bin/env bash
set -euo pipefail

if ! command -v npm >/dev/null 2>&1; then
  for dir in "$HOME"/.nvm/versions/node/*/bin; do
    if [ -x "$dir/npm" ]; then
      export PATH="$dir:$PATH"
    fi
  done
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "[pre-push] BLOCKED: npm not found on PATH." >&2
  exit 1
fi

ZERO_SHA="0000000000000000000000000000000000000000"
NEED_FULL_CHECK=0
NEED_FAST_CHECK=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi

  if [ "$remote_ref" = "refs/heads/main" ]; then
    if [ "$local_ref" != "refs/heads/main" ]; then
      echo "[pre-push] BLOCKED: only local \"main\" can push to \"origin/main\" (tried \"$local_ref\")." >&2
      exit 1
    fi
    if [ -n "$(git status --porcelain)" ]; then
      echo "[pre-push] BLOCKED: working tree is not clean. Commit or stash changes before pushing to main." >&2
      exit 1
    fi
    NEED_FULL_CHECK=1
  elif [ "$remote_ref" = "refs/heads/dev" ]; then
    NEED_FULL_CHECK=1
  elif [[ "$remote_ref" == refs/tags/v* ]]; then
    if ! git merge-base --is-ancestor "$local_sha" refs/heads/main; then
      echo "[pre-push] BLOCKED: release tag \"$remote_ref\" must point to a commit on \"main\"." >&2
      exit 1
    fi
    NEED_FULL_CHECK=1
  else
    NEED_FAST_CHECK=1
  fi
done

if [ "$NEED_FULL_CHECK" -eq 1 ]; then
  echo "[pre-push] Running full check suite (types, lint, unit tests, build)..."
  npm run check
elif [ "$NEED_FAST_CHECK" -eq 1 ]; then
  echo "[pre-push] Running fast check suite (types, lint)..."
  npm run test:types && npm run lint
fi
